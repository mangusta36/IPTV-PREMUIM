{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-cache, max-age=0"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "max-age=0"
        }
      ]
    }
  ]
}
